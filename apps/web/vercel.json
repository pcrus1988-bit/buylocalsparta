{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --ignore-scripts --prefix ../..",
  "outputDirectory": ".next",
  "buildCommand": "npm run build",
  "env": {
    "MOLLIE_PROFILE_ID": "pfl_M24SSJoWCE"
  },
  "crons": [
    {
      "path": "/api/cron/catalogue-crawler",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/delivery-dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/pending-payments",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/nova-canonical-media",
      "schedule": "17,47 * * * *"
    },
    {
      "path": "/api/cron/merchant-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/merchant-status",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/order-sla",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/seo-production-metrics",
      "schedule": "37 4 * * *"
    },
    {
      "path": "/api/cron/symphonya-catalogue",
      "schedule": "2 * * * *"
    },
    {
      "path": "/api/cron/symphonya-materialization",
      "schedule": "22 * * * *"
    },
    {
      "path": "/api/cron/symphonya-stock",
      "schedule": "*/5 * * * *"
    }
  ]
}
