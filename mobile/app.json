{
  "expo": {
    "name": "KONTA MOY Companion",
    "slug": "kontamou-companion",
    "scheme": "kontamoucompanion",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "site.kontamou.companion",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#193E32",
          "defaultChannel": "shopping-reminders"
        }
      ]
    ],
    "extra": {
      "marketplaceUrl": "https://kontamou.site"
    },
    "platforms": [
      "android"
    ]
  }
}
