# Shared by all worker roles
NODE_ENV=production
DATABASE_URL=postgresql://...
BLS_DB_APPLICATION_NAME=buy-local-sparta-worker
BLS_WORKER_ROLE=postgres

# postgres role
BLS_WORKER_POLL_MS=5000
BLS_WORKER_ID=

# catalogue crawler role
# Deploy as a continuously running isolated worker service, never as a request/response web function.
# Set BLS_WORKER_ROLE=crawler on that service and expose BLS_CRAWLER_HEALTH_PORT only to the platform health probe.
BLS_CRAWLER_WORKER_ID=
BLS_CRAWLER_POLL_MS=2000
BLS_CRAWLER_LEASE_SECONDS=300
BLS_CRAWLER_REQUEST_TIMEOUT_MS=15000
BLS_CRAWLER_MAX_ATTEMPTS=5
BLS_CRAWLER_MAX_SITEMAPS=32
BLS_CRAWLER_RETRY_BASE_SECONDS=30
BLS_CRAWLER_USER_AGENT=KONTAMOU-CatalogBot/1.0 (+https://kontamou.site/)
BLS_CRAWLER_HEALTH_PORT=8081

# search role
BLS_SEARCH_ENABLED=true
MEILISEARCH_URL=https://...
MEILISEARCH_INDEX_UID=bls_products_v1
MEILISEARCH_ADMIN_KEY=
BLS_SEARCH_RECONCILE_MS=30000
BLS_SEARCH_WORKER_ID=

# notifications role
BLS_EMAIL_DELIVERY_ENABLED=true
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
BLS_NOTIFICATION_SUPPRESSION_SECRET=
BLS_NOTIFICATION_POLL_MS=5000
BLS_NOTIFICATION_BATCH_SIZE=50
BLS_NOTIFICATION_WORKER_ID=

# media role
# Production KONTA MOU uses the private Supabase Storage bucket. Generate the S3
# access-key pair in Supabase Storage > Configuration > S3 and inject it only as
# server-side secrets. Never commit either credential.
BLS_MEDIA_PIPELINE_ENABLED=true
BLS_OBJECT_STORAGE_BUCKET=buy-local-sparta-private
BLS_OBJECT_STORAGE_REGION=us-east-1
BLS_OBJECT_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
BLS_OBJECT_STORAGE_FORCE_PATH_STYLE=true
BLS_OBJECT_STORAGE_ACCESS_KEY_ID=
BLS_OBJECT_STORAGE_SECRET_ACCESS_KEY=
BLS_CLAMAV_HOST=127.0.0.1
BLS_CLAMAV_PORT=3310
BLS_CLAMAV_TIMEOUT_MS=30000
BLS_MEDIA_WORKER_POLL_MS=5000
BLS_MEDIA_WORKER_ID=

# reports role
# Web must set BLS_REPORT_ASYNC_ENABLED=true before high-complexity reports are delegated here.
BLS_REPORT_POLL_MS=5000
BLS_REPORT_BATCH_SIZE=2
BLS_REPORT_WORKER_ID=
