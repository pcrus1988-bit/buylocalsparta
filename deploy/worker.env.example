# Shared by all worker roles
NODE_ENV=production
DATABASE_URL=postgresql://...
BLS_DB_APPLICATION_NAME=buy-local-sparta-worker
BLS_WORKER_ROLE=postgres

# postgres role
BLS_WORKER_POLL_MS=5000
BLS_WORKER_ID=

# catalogue crawler role
# Deploy as a continuously running isolated worker service, never as a request/response web function.
# Set BLS_WORKER_ROLE=crawler on that service and expose BLS_CRAWLER_HEALTH_PORT only to the platform health probe.
BLS_CRAWLER_WORKER_ID=
BLS_CRAWLER_POLL_MS=2000
BLS_CRAWLER_LEASE_SECONDS=300
BLS_CRAWLER_REQUEST_TIMEOUT_MS=15000
BLS_CRAWLER_MAX_ATTEMPTS=5
BLS_CRAWLER_MAX_SITEMAPS=32
BLS_CRAWLER_RETRY_BASE_SECONDS=30
BLS_CRAWLER_USER_AGENT=KONTAMOU-CatalogBot/1.0 (+https://kontamou.site/)
BLS_CRAWLER_HEALTH_PORT=8081

# Open Icecat bulk-index role
# Deploy as a continuously running isolated worker with BLS_WORKER_ROLE=icecat.
# The worker performs one full EL index bootstrap, then daily EL index runs. It uses a
# PostgreSQL advisory lock plus durable source-row checkpoints, so only one instance ingests at a time.
# Prefer an Icecat API token. Basic credentials are supported only as a compatibility fallback.
ICECAT_API_TOKEN=
ICECAT_USERNAME=
ICECAT_PASSWORD=
BLS_OPEN_ICECAT_WORKER_ID=
BLS_OPEN_ICECAT_INTERVAL_MS=86400000
BLS_OPEN_ICECAT_RETRY_MS=3600000
BLS_OPEN_ICECAT_LOCK_RETRY_MS=60000
BLS_OPEN_ICECAT_FETCH_TIMEOUT_MS=7200000
BLS_OPEN_ICECAT_BATCH_SIZE=500
BLS_OPEN_ICECAT_MAX_RECORD_CHARS=8388608
BLS_OPEN_ICECAT_HEALTH_PORT=8082
BLS_OPEN_ICECAT_RUN_ONCE=false

# Open Icecat governed product-detail role
# Deploy independently with BLS_WORKER_ROLE=icecat-detail. This worker consumes only
# completed index evidence and writes catalog_source_products, EL localizations and
# unmapped source attributes. It never creates canonical products, offers, prices or stock.
# The detail API requires both the Icecat username/shop name and API token.
ICECAT_CONTENT_TOKEN=
BLS_OPEN_ICECAT_DETAIL_WORKER_ID=
BLS_OPEN_ICECAT_DETAIL_POLL_MS=2000
BLS_OPEN_ICECAT_DETAIL_SYNC_INTERVAL_MS=300000
BLS_OPEN_ICECAT_DETAIL_BATCH_SIZE=5
BLS_OPEN_ICECAT_DETAIL_LEASE_SECONDS=300
BLS_OPEN_ICECAT_DETAIL_REQUEST_TIMEOUT_MS=15000
BLS_OPEN_ICECAT_DETAIL_RATE_DELAY_MS=750
BLS_OPEN_ICECAT_DETAIL_MAX_ATTEMPTS=5
BLS_OPEN_ICECAT_DETAIL_RETRY_BASE_SECONDS=60
BLS_OPEN_ICECAT_DETAIL_HEALTH_PORT=8083
BLS_OPEN_ICECAT_DETAIL_RUN_ONCE=false
BLS_OPEN_ICECAT_MIN_GREEK_SCORE=0.9

# search role
BLS_SEARCH_ENABLED=true
MEILISEARCH_URL=https://...
MEILISEARCH_INDEX_UID=bls_products_v1
MEILISEARCH_ADMIN_KEY=
BLS_SEARCH_RECONCILE_MS=30000
BLS_SEARCH_WORKER_ID=

# notifications role
BLS_EMAIL_DELIVERY_ENABLED=true
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
BLS_NOTIFICATION_SUPPRESSION_SECRET=
BLS_NOTIFICATION_POLL_MS=5000
BLS_NOTIFICATION_BATCH_SIZE=50
BLS_NOTIFICATION_WORKER_ID=

# media role
# Production KONTA MOU uses the private Supabase Storage bucket. Generate the S3
# access-key pair in Supabase Storage > Configuration > S3 and inject it only as
# server-side secrets. Never commit either credential.
BLS_MEDIA_PIPELINE_ENABLED=true
BLS_OBJECT_STORAGE_BUCKET=buy-local-sparta-private
BLS_OBJECT_STORAGE_REGION=us-east-1
BLS_OBJECT_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
BLS_OBJECT_STORAGE_FORCE_PATH_STYLE=true
BLS_OBJECT_STORAGE_ACCESS_KEY_ID=
BLS_OBJECT_STORAGE_SECRET_ACCESS_KEY=
BLS_CLAMAV_HOST=127.0.0.1
BLS_CLAMAV_PORT=3310
BLS_CLAMAV_TIMEOUT_MS=30000
BLS_MEDIA_WORKER_POLL_MS=5000
BLS_MEDIA_WORKER_ID=

# reports role
# Web must set BLS_REPORT_ASYNC_ENABLED=true before high-complexity reports are delegated here.
BLS_REPORT_POLL_MS=5000
BLS_REPORT_BATCH_SIZE=2
BLS_REPORT_WORKER_ID=
