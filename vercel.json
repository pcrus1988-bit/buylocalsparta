{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --ignore-scripts --include=dev",
  "buildCommand": "npm ci --ignore-scripts --include=dev && npm --workspace @buy-local-sparta/web run build",
  "devCommand": "npm --workspace @buy-local-sparta/web run dev",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/delivery-dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/nova-canonical-media",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/symphonya-catalogue",
      "schedule": "2 * * * *"
    },
    {
      "path": "/api/cron/symphonya-stock",
      "schedule": "7,17,27,37,47,57 * * * *"
    },
    {
      "path": "/api/cron/symphonya-pipeline",
      "schedule": "9 * * * *"
    },
    {
      "path": "/api/cron/dropship-order-reconciliation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/flash-sale-availability",
      "schedule": "*/5 * * * *"
    }
  ]
}
