# Official GEMI OpenData — server-side only. Never expose through NEXT_PUBLIC_* or commit a real key.
GEMI_OPENDATA_API_KEY=
GEMI_OPENDATA_BASE_URL=https://opendata-api.businessportal.gr/api/opendata/v1
# GEMI issued allowance is 8 req/min; KONTA MOY intentionally defaults to 7 to retain headroom.
GEMI_OPENDATA_REQUESTS_PER_MINUTE=7
GEMI_OPENDATA_REQUEST_TIMEOUT_MS=15000
GEMI_OPENDATA_MAX_RETRIES=3
GEMI_OPENDATA_CACHE_TTL_MS=86400000
