# Runtime used by the dependency-free development server
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Reserved application defaults for the production adapter layer
APP_URL=http://localhost:3000
DEFAULT_MARKET=sparta
DEFAULT_LOCALE=el
DEFAULT_TIMEZONE=Europe/Athens

# Database (production target: PostgreSQL 18.x + PostGIS)
# When DATABASE_URL is configured, customer identity/session/personalization/notification/privacy state automatically uses PostgreSQL.
DATABASE_URL=postgresql://buy_local_sparta:change-me@localhost:5432/buy_local_sparta
BLS_DB_APPLICATION_NAME=buy-local-sparta-web
BLS_DB_POOL_MAX=10
BLS_DB_CONNECT_TIMEOUT_MS=5000
BLS_DB_IDLE_TIMEOUT_MS=30000
BLS_WORKER_POLL_MS=5000
# Optional explicit worker identity; default is hostname + process id.
BLS_WORKER_ID=
REDIS_URL=redis://localhost:6379

# Production public search — Meilisearch external canonical-product projection.
# Web/search API needs only MEILISEARCH_SEARCH_KEY. Index-management/admin key belongs on the search worker/configure job only.
BLS_SEARCH_ENABLED=false
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_INDEX_UID=bls_products_v1
MEILISEARCH_SEARCH_KEY=
MEILISEARCH_ADMIN_KEY=
MEILISEARCH_TIMEOUT_MS=5000
MEILISEARCH_TASK_TIMEOUT_MS=20000
MEILISEARCH_TASK_POLL_MS=100
BLS_SEARCH_RECONCILE_MS=30000
BLS_SEARCH_WORKER_ID=
# Legacy generic search aliases retained only for older local tooling.
SEARCH_URL=http://localhost:7700
SEARCH_API_KEY=

# Transactional email — Resend transport over the durable PostgreSQL notification queue.
BLS_EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
RESEND_BASE_URL=https://api.resend.com
RESEND_WEBHOOK_SECRET=
RESEND_TIMEOUT_MS=8000
# HMAC secret used only to store privacy-minimised suppression hashes. Use >=32 random bytes and keep stable across instances.
BLS_NOTIFICATION_SUPPRESSION_SECRET=
BLS_NOTIFICATION_WORKER_ID=
BLS_NOTIFICATION_POLL_MS=5000
BLS_NOTIFICATION_BATCH_SIZE=50

# Reporting engine.
# Keep false unless at least one long-lived reports worker is running. Inline report generation remains fully functional when false.
BLS_REPORT_ASYNC_ENABLED=false
# The following values are worker-side controls for BLS_WORKER_ROLE=reports.
BLS_REPORT_POLL_MS=5000
BLS_REPORT_BATCH_SIZE=2
BLS_REPORT_WORKER_ID=

# Private media object storage (S3-compatible). Prefer workload/IAM credentials in production.
BLS_MEDIA_PIPELINE_ENABLED=false
BLS_OBJECT_STORAGE_BUCKET=buy-local-sparta-private
BLS_OBJECT_STORAGE_REGION=eu-central-1
BLS_OBJECT_STORAGE_ENDPOINT=
BLS_OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Exact origin used by browser presigned PUTs; added to CSP connect-src. Example:
# https://buy-local-sparta-private.s3.eu-central-1.amazonaws.com
BLS_MEDIA_UPLOAD_ORIGIN=
BLS_MEDIA_UPLOAD_TTL_SECONDS=900
BLS_MEDIA_MAX_BYTES=26214400
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Legacy aliases retained for local S3-compatible environments.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Malware scanning worker only. The Vercel web app does not need BLS_CLAMAV_HOST for readiness.
# clamd TCP must be on a private/trusted network only.
BLS_CLAMAV_HOST=
BLS_CLAMAV_PORT=3310
BLS_CLAMAV_TIMEOUT_MS=60000
BLS_MEDIA_WORKER_POLL_MS=5000
BLS_MEDIA_WORKER_ID=

# Authentication
AUTH_SECRET=replace-with-32-plus-random-bytes
PICKUP_SIGNING_SECRET=replace-with-a-separate-32-plus-random-byte-secret

# Payments — Viva.com Smart Checkout (seller-of-record merchant account)
# Keep false until the Viva merchant account, Smart Checkout credentials, payment source and webhooks are configured.
VIVA_PAYMENTS_ENABLED=false
# demo or live. Production refuses demo unless the explicit preview escape hatch below is true.
VIVA_ENVIRONMENT=demo
# Smart Checkout OAuth2 credentials from Viva API Access. Server-only secrets.
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
# Merchant ID/API Key used by Viva classic APIs for webhook verification, order cancellation and refunds. Server-only secrets.
VIVA_MERCHANT_ID=
VIVA_API_KEY=
# Website/App payment source code configured in Viva (success: /checkout/success, failure: /checkout/failure).
VIVA_SOURCE_CODE=
VIVA_PAYMENT_TIMEOUT_SECONDS=900
VIVA_REQUEST_TIMEOUT_MS=10000
# Preview-only. Never use Viva demo credentials for real production traffic.
BLS_ALLOW_VIVA_DEMO_PREVIEW=false

# Tax / ERP / AADE myDATA (ERP channel)
# AADE ERP API defaults track the current v2.0.2 endpoints. AADE_MYDATA_BASE_URL remains available as an explicit deployment override.
# Keep issuance false until the accountant/legal seller-of-record mapping is approved. Read-only connectivity checks do not require issuance to be enabled.
BLS_MYDATA_ISSUANCE_ENABLED=false
BLS_MYDATA_MAPPING_VERSION=
AADE_MYDATA_ENVIRONMENT=test
# Defaults: test=https://mydataapidev.aade.gr ; production=https://mydatapi.aade.gr/myDATA
AADE_MYDATA_BASE_URL=
AADE_MYDATA_USER_ID=
AADE_MYDATA_SUBSCRIPTION_KEY=
AADE_MYDATA_SPEC_VERSION=2.0.2
AADE_MYDATA_REQUEST_TIMEOUT_MS=15000
# Legacy generic ERP placeholders retained for a future accounting-suite adapter if needed.
ERP_PROVIDER=dev
ERP_API_URL=
ERP_API_KEY=

# Messaging / external advice
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WHATSAPP_TOKEN=
VIBER_TOKEN=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

# Safety
FILE_SCAN_PROVIDER=dev


# BOX NOW Partner API + locker widget. Keep stage credentials in staging only.
BLS_BOXNOW_ENABLED=false
BOXNOW_ENVIRONMENT=stage
BOXNOW_API_URL=
BOXNOW_CLIENT_ID=
BOXNOW_CLIENT_SECRET=
BOXNOW_WEBHOOK_SECRET=
BOXNOW_PARTNER_ID=
BOXNOW_REQUEST_TIMEOUT_MS=10000
NEXT_PUBLIC_BOXNOW_WIDGET_ENABLED=false
NEXT_PUBLIC_BOXNOW_PARTNER_ID=
BLS_ALLOW_BOXNOW_STAGE_PREVIEW=false

# Shipping/courier: DEV uses internal carrier adapter; production credentials are provider-specific
COURIER_PROVIDER=dev
COURIER_API_URL=
COURIER_API_KEY=
COURIER_WEBHOOK_SECRET=

# Production-web customer sessions. BLS_AUTH_SECRET is required with DATABASE_URL and must be identical across all web instances.
BLS_AUTH_SECRET=
# Explicitly opt into fictional demo credentials outside development. Keep false in production.
BLS_ENABLE_DEMO_ACCOUNTS=false
# Preview-only escape hatch. Never use for real customer accounts or multi-instance production.
BLS_ALLOW_EPHEMERAL_ACCOUNT_RUNTIME=false
# Preview-only vendor backoffice escape hatch. Never use for real multi-instance production.
BLS_ALLOW_EPHEMERAL_VENDOR_RUNTIME=false

# Preview-only Admin runtime. Keep false/unset in real production until PostgreSQL staff identity/audit/governance persistence is active.
BLS_ALLOW_EPHEMERAL_ADMIN_RUNTIME=false

# Global preview-only escape hatch for database readiness. Keep false/unset in real production.
# With BLS_ENABLE_DEMO_ACCOUNTS and the relevant BLS_ALLOW_EPHEMERAL_* flag, the web app uses signed stateless demo sessions so serverless preview logins survive across invocations.
BLS_ALLOW_DATABASELESS_PREVIEW=false


# Deployment activation evidence / staging preflight
# Use local, preview, staging or production. This label is persisted with redacted activation evidence.
BLS_DEPLOYMENT_ENVIRONMENT=local
# Comma-separated gates that must pass for stage:preflight to exit successfully.
# Example full staging gate: database,viva,mydata,search,email,object_storage,clamav,boxnow,web
BLS_ACTIVATION_REQUIRED_PROVIDERS=database
# Optional deployed base URL checked via /api/health/ready. Can also be supplied as --web-url=https://...
BLS_ACTIVATION_WEB_URL=
# Connectivity evidence is intentionally short-lived so an old successful check cannot approve a new release forever.
BLS_ACTIVATION_EVIDENCE_TTL_HOURS=72
