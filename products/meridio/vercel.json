{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/workspace",
      "destination": "/intake",
      "permanent": true
    },
    {
      "source": "/workspace/:path*",
      "destination": "/intake",
      "permanent": true
    },
    {
      "source": "/review-lab",
      "destination": "/intake",
      "permanent": true
    },
    {
      "source": "/review-lab/:path*",
      "destination": "/intake",
      "permanent": true
    }
  ]
}
